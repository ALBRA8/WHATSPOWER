PORT=3003
NODE_ENV=production

# ===== SECRETOS (CP-Sec-01: NUNCA uses valores de ejemplo publicados en producción) =====
# Secret Bearer para TODAS las rutas administrativas /api/* (mínimo 24 caracteres aleatorios).
# Genera uno con: openssl rand -hex 32
INTERNAL_API_SECRET=
# Secret HMAC del Inbound Bridge (debe coincidir con WHATSPOWER_WEBHOOK_SECRET del CRM).
# Debe coincidir con el emisor; mínimo 24 caracteres aleatorios.
AGENTIC_2A_WEBHOOK_SECRET=
# (Legacy, opcional) Solo si aún usas el nombre antiguo. Tiene menor prioridad.
# WEBHOOK_SECRET=
# Secret HMAC del webhook de la pasarela de pagos (POST /api/payments/webhook). Sin él, 503.
PAYMENTS_WEBHOOK_SECRET=

# ===== TRANSPORTE (MOCK vs REAL — decisión explícita) =====
# TRANSPORT=http  → envíos reales vía daemon WhatsApp (requiere INTERNAL_API_SECRET).
# TRANSPORT=mock  → simulador; en producción exige además ALLOW_MOCK_TRANSPORT=true.
TRANSPORT=mock
# Salvaguarda dura de envío real: con false, HttpAlbraTransportSender BLOQUEA todo envío.
ALLOW_REAL_DISPATCH=false
# Solo para laboratorio: aceptar Mock en producción (decisión explícita y audible en logs).
# ALLOW_MOCK_TRANSPORT=true

# ===== PUENTE CRM (tercera reparación 4.D: contrato con confirmación de organización) =====
CRM_BASE_URL=http://localhost:3000
# API key de la organización en el CRM (Settings > API keys, formato albra_...).
# En producción sin CRM_API_KEY el arranque FALLA (prohibido el Mock silencioso).
CRM_API_KEY=
# Multi-organización: credenciales POR organización (JSON {orgId: "albra_..."}).
# Una credencial de una org JAMÁS se usa para otra; una org sin clave falla (fail-closed).
CRM_API_KEYS=
# El cliente exige que el CRM confirme la organización en la respuesta (campo orgId):
# respuestas SIN org se rechazan (TENANT_UNVERIFIED) y con org ajena también (TENANT_MISMATCH).

# ===== MULTI-ORGANIZACIÓN (tercera reparación 4.A/4.B — X-Org-Id obligatorio) =====
# TODOS los endpoints administrativos (/api/flows, /api/team/*, /api/canned,
# /api/growth/links, /api/internal/*) exigen el header X-Org-Id y operan
# EXCLUSIVAMENTE dentro de esa organización. La organización NUNCA se infiere
# del body ni de datos no confiables.

# URL del daemon WhatsApp de Capa 1 (usada por /qr/data y TRANSPORT=http)
WHATSAPP_DAEMON_URL=http://localhost:3002

# ===== REPARACIÓN INTEGRAL 2026-11-06 =====
# Ruta del anti-replay durable (default: db/replay-cache.db; ':memory:' solo tests)
REPLAY_DB_PATH=

# ===== PAGOS (tercera reparación 4.E: sin valores de prueba presentados como producción) =====
# Permitir pasarela simulator en producción (decisión explícita y audible; default: bloqueado)
PAYMENTS_ALLOW_SIMULATOR=false
# Clave pública Wompi (obligatoria con gateway=wompi; sin ella se RECHAZA la creación del link)
WOMPI_PUBLIC_KEY=
# Prefijo real de Payment Links de MercadoPago (obligatorio con gateway=mercadopago)
MERCADOPAGO_LINK_PREFIX=
# Prefijo real de Payment Links de Stripe de la cuenta (obligatorio con gateway=stripe)
STRIPE_PAYMENT_LINK_PREFIX=

# ===== IDEMPOTENCIA (tercera reparación 4.C — modelo de entrega real) =====
# MODELO DE ENTREGA: at-least-once con efectos idempotentes (journal de efectos:
# un mensaje ya enviado jamás se reenvía por un fallo posterior). NO se promete
# exactly-once: los eventos con resultado incierto quedan UNCERTAIN y exigen
# reconciliación explícita (POST /api/internal/idempotency/reconcile).
# SOLO para laboratorio/pruebas (producción usa los valores por defecto 120/30000):
# IDEMPOTENCY_LEASE_SECONDS=
# LEASE_RENEWAL_INTERVAL_MS=
