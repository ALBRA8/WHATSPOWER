PORT=3003
NODE_ENV=production

# (Legacy) Secret del Inbound Bridge — mantener solo por compatibilidad.
WEBHOOK_SECRET=your_webhook_secret_here
# Secret HMAC del Inbound Bridge (debe coincidir con WHATSPOWER_WEBHOOK_SECRET del CRM).
# Tiene prioridad sobre WEBHOOK_SECRET.
AGENTIC_2A_WEBHOOK_SECRET=tu_secreto_hmac_32_caracteres

# CRM Actions Bridge (WhatsPower -> CRM-ALBRA)
CRM_BASE_URL=http://localhost:3000
# API key de la organización en el CRM (Settings > API keys, formato albra_...)
CRM_API_KEY=

WHATSAPP_DAEMON_URL=http://localhost:3002
ALLOW_REAL_DISPATCH=false
