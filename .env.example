PORT=3003
NODE_ENV=production

# ===== SECRETOS (CP-Sec-01: NUNCA uses valores de ejemplo publicados en producción) =====
# Claves de API POR ORGANIZACIÓN (contrato v1.1.0 §1-§2): "orgId:secreto[:rol],...".
# El rol puede ser 'admin' (libera locks, elimina supresiones) o 'agent'.
# Genera secretos con: openssl rand -hex 32  (mínimo 16 caracteres por secreto)
INTERNAL_API_KEYS=
# (Legado) Secret Bearer para /api/*: resuelve a la organización "default" con rol admin.
# Mantener SOLO para transición de servicios que aún no usan INTERNAL_API_KEYS.
INTERNAL_API_SECRET=
# Secret HMAC del Inbound Bridge (debe coincidir con WHATSPOWER_WEBHOOK_SECRET del CRM).
# Debe coincidir con el emisor; mínimo 24 caracteres aleatorios.
AGENTIC_2A_WEBHOOK_SECRET=
# (Legacy, opcional) Solo si aún usas el nombre antiguo. Tiene menor prioridad.
# WEBHOOK_SECRET=
# (Recomendado en producción) Secretos de webhook POR ORGANIZACIÓN: "orgId:secreto,...".
# El secreto que valida el HMAC VINCULA la organización (el orgId del payload que no
# coincida → 403). Con solo el secreto legado, la org viene del payload autenticado.
# WEBHOOK_SECRETS=
# Secret HMAC del webhook de la pasarela de pagos (POST /api/payments/webhook). Sin él, 503.
PAYMENTS_WEBHOOK_SECRET=

# ===== PAGOS (contrato v1.1.0 §6) =====
# simulator|sandbox|production. Obligatorio en producción; el simulador jamás se
# presenta como cobro real y en modo simulator TODA pasarela real es forzada al simulador.
PAYMENTS_MODE=simulator
# Credenciales públicas de pasarela (SOLO necesarias con PAYMENTS_MODE=sandbox|production;
# en production su ausencia hace fail-closed la creación de enlaces reales).
# WOMPI_PUBLIC_KEY=
# MERCADOPAGO_ACCESS_TOKEN=
# STRIPE_SECRET_KEY=

# ===== PROXY (contrato v1.1.0 §7) =====
# Solo con 'true' se respeta x-forwarded-for para la IP del cliente (rate limiting/logs).
# TRUST_PROXY=false

# ===== TRANSPORTE (MOCK vs REAL — decisión explícita) =====
# TRANSPORT=http  → envíos reales vía daemon WhatsApp (requiere INTERNAL_API_SECRET).
# TRANSPORT=mock  → simulador; en producción exige además ALLOW_MOCK_TRANSPORT=true.
TRANSPORT=mock
# Salvaguarda dura de envío real: con false, HttpAlbraTransportSender BLOQUEA todo envío.
ALLOW_REAL_DISPATCH=false
# Solo para laboratorio: aceptar Mock en producción (decisión explícita y audible en logs).
# ALLOW_MOCK_TRANSPORT=true

# ===== PUENTE CRM =====
CRM_BASE_URL=http://localhost:3000
# API key de la organización en el CRM (Settings > API keys, formato albra_...).
# En producción sin CRM_API_KEY el arranque FALLA (prohibido el Mock silencioso).
CRM_API_KEY=

# URL del daemon WhatsApp de Capa 1 (usada por /qr/data y TRANSPORT=http)
WHATSAPP_DAEMON_URL=http://localhost:3002
