PORT=3003
NODE_ENV=production

# ===== SECRETOS (CP-Sec-01: NUNCA uses valores de ejemplo publicados en producción) =====
# Secret Bearer para TODAS las rutas administrativas /api/* (mínimo 24 caracteres aleatorios).
# Genera uno con: openssl rand -hex 32
INTERNAL_API_SECRET=
# Secret HMAC del Inbound Bridge (debe coincidir con WHATSPOWER_WEBHOOK_SECRET del CRM).
# Debe coincidir con el emisor; mínimo 24 caracteres aleatorios.
AGENTIC_2A_WEBHOOK_SECRET=
# (Legacy, opcional) Solo si aún usas el nombre antiguo. Tiene menor prioridad.
# WEBHOOK_SECRET=
# Secret HMAC del webhook de la pasarela de pagos (POST /api/payments/webhook). Sin él, 503.
PAYMENTS_WEBHOOK_SECRET=

# ===== TRANSPORTE (MOCK vs REAL — decisión explícita) =====
# TRANSPORT=http  → envíos reales vía daemon WhatsApp (requiere INTERNAL_API_SECRET).
# TRANSPORT=mock  → simulador; en producción exige además ALLOW_MOCK_TRANSPORT=true.
TRANSPORT=mock
# Salvaguarda dura de envío real: con false, HttpAlbraTransportSender BLOQUEA todo envío.
ALLOW_REAL_DISPATCH=false
# Solo para laboratorio: aceptar Mock en producción (decisión explícita y audible en logs).
# ALLOW_MOCK_TRANSPORT=true

# ===== PUENTE CRM =====
CRM_BASE_URL=http://localhost:3000
# API key de la organización en el CRM (Settings > API keys, formato albra_...).
# En producción sin CRM_API_KEY el arranque FALLA (prohibido el Mock silencioso).
CRM_API_KEY=

# URL del daemon WhatsApp de Capa 1 (usada por /qr/data y TRANSPORT=http)
WHATSAPP_DAEMON_URL=http://localhost:3002
