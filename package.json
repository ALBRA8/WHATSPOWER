{
  "name": "whatspower",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "WHATSPOWER (Nivel 2) — Automatización Conversacional y Flujos Inteligentes para CRM ALBRA",
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "build": "node --experimental-strip-types scripts/build-dashboard.ts",
    "test": "node scripts/run-tests.mjs",
    "e2e:3": "node scripts/e2e-3-servicios.mjs",
    "sequences:run": "node --experimental-strip-types scripts/run-sequences.ts",
    "waits:run": "node --experimental-strip-types scripts/run-waits.ts",
    "tsc": "tsc --noEmit -p tsconfig.json",
    "security:scan": "node scripts/scan-secrets.mjs",
    "security:scan:history": "node scripts/scan-secrets.mjs --history",
    "check:pii": "node scripts/check-pii.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "typescript": "^5.9.3"
  }
}
